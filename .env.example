# For the command line only. The desktop app stores keys in its Settings.
# Free default: Google Gemini free tier (aistudio.google.com/apikey, no card)
GEMINI_API_KEY=AIza...
# GROQ_API_KEY=gsk_...           # optional free backup (console.groq.com/keys)
# SCOUT_PROVIDER=gemini          # gemini | groq | ollama | claude
# GEMINI_MODEL=                  # empty = pick a Flash-Lite model automatically
# OLLAMA_MODEL=qwen3:8b          # for SCOUT_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# ANTHROPIC_API_KEY=sk-ant-...   # for SCOUT_PROVIDER=claude (paid)
# SCOUT_MODEL=claude-opus-5-5
# optional
NOTION_TOKEN=ntn_...
# NOTION_WATCHLIST_DB=<database link or id>
